# Copy to .env. Any OpenAI-compatible endpoint works.
# Local Ollama (default; counts as a small model on our laptop):
BASE_URL=http://localhost:11434/v1
API_KEY=ollama
MODEL_NAME=qwen2.5:1.5b
# Groq instead:
# BASE_URL=https://api.groq.com/openai/v1
# API_KEY=gsk_your_key_here
# MODEL_NAME=llama-3.1-8b-instant
# Optional: parallel calls (default 4), per-call timeout in seconds
# LLM_PARALLEL=4
# LLM_TIMEOUT=110
